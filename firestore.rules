rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read, write: if own(userId);
      match /{document=**} { allow read, write: if own(userId); }
    }

    match /{collection}/{documentId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }
  }
}
